        {
          "name": "High Yielding Animal List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/v1/farmer/high-yielding-animal",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "v1", "farmer", "high-yielding-animal"]
            },
            "description": "Returns farmer high yielding animal records with file_url.\n\nMatches web route `GET /high-yielding-animal`."
          },
          "response": []
        },
        {
          "name": "Add Yielding Animal Form",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/v1/farmer/add-yielding-animal",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "v1", "farmer", "add-yielding-animal"]
