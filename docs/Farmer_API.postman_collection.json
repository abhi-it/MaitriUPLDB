        {
          "name": "Add Update Animal Details",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "type",
                  "value": "cow",
                  "description": "buffalo | cow | goat | horse (required)",
                  "type": "text"
                },
