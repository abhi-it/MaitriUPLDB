{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-maitriapi0001",
    "name": "MaitriUPLDB Maitri API",
    "description": "Maitri login + dashboard, request list, profile APIs.\n\n1. Set `base_url`\n2. Run **Maitri Login** (saves `maitri_token`)\n3. Call authenticated APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "maitri_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth (Public)",
      "item": [
        {
          "name": "Maitri Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json && json.data && json.data.token) {",
                  "        pm.collectionVariables.set('maitri_token', json.data.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "maitri@example.com",
                  "description": "Email from maitries table (required)",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password123",
                  "description": "Password (required)",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/maitri-login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "maitri-login"]
            },
            "description": "Login using maitries.email + password.\nReturns JWT for maitri_api guard.\nFirst validation error only."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authenticated Maitri",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{maitri_token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/v1/maitri/dashboard?per_page=10&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "v1", "maitri", "dashboard"],
              "query": [
                {
                  "key": "per_page",
                  "value": "10",
                  "description": "Optional page size"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Optional page number"
                }
              ]
            },
            "description": "Maitri dashboard with service requests.\nMatches web `GET /maitri-dashboard`."
          },
          "response": []
        },
        {
          "name": "Dashboard Data (Animal Upload)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "categories",
                  "value": "sexed_semen_calf_born_elite_calf",
                  "description": "Category (required)",
                  "type": "text"
                },
                {
                  "key": "animal_file",
                  "description": "Animal image file max 2MB (required)",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/auth/v1/maitri/dashboard-data",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "v1", "maitri", "dashboard-data"]
            },
            "description": "Upload animal service from maitri dashboard.\nMatches web `POST /maitri-dashdata`."
          },
          "response": []
        },
        {
          "name": "Request List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/v1/maitri/request-list?per_page=10&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "v1", "maitri", "request-list"],
              "query": [
                {
                  "key": "per_page",
                  "value": "10",
                  "description": "Optional"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Optional"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "Optional filter: 0 Accept, 1 New, 2 Waiting, 3 Decline",
                  "disabled": true
                }
              ]
            },
            "description": "List service requests assigned to logged-in maitri.\nMatches web `GET /request-list`."
          },
          "response": []
        },
        {
          "name": "Update Service Request Status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Service request id (required)",
                  "type": "text"
                },
                {
                  "key": "status",
                  "value": "0",
                  "description": "0 Accept, 1 New, 2 Waiting, 3 Decline (required)",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/auth/v1/maitri/update-service-request",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "v1", "maitri", "update-service-request"]
            },
            "description": "Update request status for this maitri only.\nMatches web `POST /updateServiceRequest`.\nAlso accepts `val` instead of `status`."
          },
          "response": []
        },
        {
          "name": "Maitri Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/v1/maitri/maitri-details",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "v1", "maitri", "maitri-details"]
            },
            "description": "Get logged-in maitri profile + location dropdowns.\nMatches web `GET /maitri-details`."
          },
          "response": []
        },
        {
          "name": "Update Maitri Details",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "first_name",
                  "value": "Maitri Name",
                  "description": "Optional partial update field",
                  "type": "text"
                },
                {
                  "key": "MobileNumber",
                  "value": "9876543210",
                  "description": "Optional mobile",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "maitri@example.com",
                  "description": "Optional email",
                  "type": "text"
                },
                {
                  "key": "gender",
                  "value": "male",
                  "description": "Optional gender",
                  "type": "text"
                },
                {
                  "key": "division_id",
                  "value": "1",
                  "description": "Optional mandal id",
                  "type": "text"
                },
                {
                  "key": "district_id",
                  "value": "1",
                  "description": "Optional district id",
                  "type": "text"
                },
                {
                  "key": "tehsil",
                  "value": "सदर",
                  "description": "Optional tehsil",
                  "type": "text"
                },
                {
                  "key": "block",
                  "value": "ब्लाक 1",
                  "description": "Optional block",
                  "type": "text"
                },
                {
                  "key": "post_office",
                  "value": "Main PO",
                  "description": "Optional post office",
                  "type": "text"
                },
                {
                  "key": "pincode",
                  "value": "226001",
                  "description": "Optional pincode",
                  "type": "text"
                },
                {
                  "key": "gram_panchayat",
                  "value": "GP 1",
                  "description": "Optional gram panchayat",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "",
                  "description": "Optional new password (min 8)",
                  "type": "text"
                },
                {
                  "key": "password_confirmation",
                  "value": "",
                  "description": "Required only if password sent",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/auth/v1/maitri/update-maitri-details",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "v1", "maitri", "update-maitri-details"]
            },
            "description": "Partial profile update. Only sent fields update.\nMatches web `POST /update-maitri-details`.\nFirst validation error only."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/v1/maitri/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "v1", "maitri", "logout"]
            },
            "description": "Invalidate current maitri JWT."
          },
          "response": []
        }
      ]
    }
  ]
}
